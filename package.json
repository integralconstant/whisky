{
  "name": "whisky-note",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-standalone.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "update:prices": "node --experimental-strip-types scripts/update-dailyshot-prices.mjs",
    "update:images": "node --experimental-strip-types scripts/update-whisky-images.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src tests index.html *.json *.ts README.md"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
